{
  // markdownlint-cli2 config - the docs convention gate (see docs/README.md).
  "config": {
    // The rules come from .markdownlint.jsonc, vendored from the umbrella by the
    // `conventions.markdownlint` contract and hash-locked in .contracts.lock.json.
    // Never edit that file: edit conventions/markdownlint.jsonc in the umbrella
    // and run `sync_contracts.py pull --repo miniapp`, or CI fails on the hash.
    "extends": ".markdownlint.jsonc"
  },
  "globs": ["**/*.md"],
  "gitignore": true,
  // CHANGELOG.md files are generated by Changesets.
  "ignores": ["node_modules", "**/node_modules", "**/dist", "**/CHANGELOG.md", ".changeset/*.md"]
}
