{
  // markdownlint-cli2 config - the docs convention gate (see docs/README.md).
  "config": {
    // The rules live in .markdownlint.jsonc and the paths below, so the rule
    // set can be shared with another repository unchanged.
    "extends": ".markdownlint.jsonc"
  },
  "globs": ["**/*.md"],
  "gitignore": true,
  // CHANGELOG.md files are generated by Changesets.
  // docs/reference/api is TypeDoc's output, written by `pnpm docs:gen` and checked for drift, so its style is the generator's.
  "ignores": ["node_modules", "**/node_modules", "**/dist", "**/CHANGELOG.md", ".changeset/*.md", "docs/reference/api"]
}
