{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": [
    "packages/tokens/src/{colors,radius,spacing,typography}.ts",
    "packages/cli/templates/**",
    "examples/**"
  ],
  "ignoreIssues": {
    "pnpm-workspace.yaml": ["catalog"]
  },
  "workspaces": {
    "packages/site": {
      "entry": ["test/*.test.mjs"],
      "ignoreDependencies": ["vue"]
    },
    "packages/repo-checks": {
      "entry": ["test/*.test.mjs"],
      "ignoreDependencies": [
        "@skkuverse/miniapp",
        "@skkuverse/ui",
        "@skkuverse/tokens",
        "@skkuverse/miniapp-cli"
      ]
    },
    "packages/compat": {
      "entry": ["src/{matrix,cell,versions}.mjs", "test/*.test.mjs"],
      "ignoreDependencies": ["@skkuverse/miniapp", "happy-dom", "sdk-.*"]
    },
    "packages/miniapp-contract": {
      "vitest": false,
      "entry": ["vitest.config.ts", "test/**/*.test.ts", "test/global-setup.ts", "test/fixtures/*/src/main.tsx"]
    },
    "packages/game-contract": {
      "vitest": false,
      "entry": ["vitest.config.ts", "test/**/*.test.ts", "test/global-setup.ts", "test/fixtures/*.ts"]
    }
  },
  "rules": {
    "exports": "off",
    "types": "off",
    "nsExports": "off",
    "nsTypes": "off",
    "duplicates": "off"
  }
}
