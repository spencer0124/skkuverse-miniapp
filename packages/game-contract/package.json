{
  "name": "@skkuverse/game-contract",
  "version": "0.0.0",
  "description": "Plays a built skkuverse game page against the SDK fake host and holds it to the game protocol contract.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "game-contract": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/skkuverse/skkuverse-miniapp.git",
    "directory": "packages/game-contract"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "publint",
    "test": "vitest run"
  },
  "dependencies": {
    "@skkuverse/miniapp": "workspace:^",
    "happy-dom": "catalog:",
    "vitest": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
