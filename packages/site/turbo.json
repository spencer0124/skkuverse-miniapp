{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "dependsOn": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/docs/**",
        "$TURBO_ROOT$/README.md",
        "$TURBO_ROOT$/packages/*/README.md",
        "$TURBO_ROOT$/repo-links.json",
        "$TURBO_ROOT$/examples/**",
        "!$TURBO_ROOT$/examples/*/node_modules/**",
        "!$TURBO_ROOT$/examples/*/dist/**"
      ],
      "outputs": [".vitepress/dist/**"]
    },
    "test": {
      "dependsOn": [],
      "cache": false
    }
  }
}
